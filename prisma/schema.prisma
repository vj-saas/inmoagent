// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// TENANTS (inmobiliarias)
// ─────────────────────────────────────────────

model Tenant {
  id     String  @id @default(cuid())
  name   String
  slug   String  @unique
  active Boolean @default(true)

  // Meta WhatsApp Cloud API (credenciales de la inmobiliaria)
  phoneNumberId  String  @unique // clave de ruteo del webhook
  wabaId         String?
  accessTokenEnc String // token cifrado AES-256-GCM
  displayPhone   String? // +54 9 11 ... (informativo)

  // Configuración del bot
  botName            String   @default("Asistente")
  botTone            String   @default("cordial y profesional, voseo argentino")
  // "cercano" (default, con emojis/muletillas) | "formal" (sin emojis, registro
  // sobrio) — spec 09, T2.4. Default "cercano" para no cambiar el comportamiento
  // de tenants ya configurados.
  botFormality       String   @default("cercano")
  schedulingLink     String?
  humanHours         String?
  competitorsToAvoid String[] @default([])
  coverageAreas      String[] @default([]) // barrios/zonas que cubre
  privacyNoticeSent  Boolean  @default(true) // incluir aviso de datos en saludo

  // Textos editables por el tenant (onboarding, V-C). El backend siempre agrega
  // el aviso Ley 25.326 al saludo y la línea de `humanHours` al handoff: estos
  // campos solo reemplazan la frase de introducción, nunca los guardrails.
  welcomeIntro String? // primera frase del saludo (el aviso Ley 25.326 lo agrega el backend)
  handoffIntro String? // frase intro del handoff (la línea de humanHours la agrega el backend)

  // Notificación interna (handoff/agendamiento) — ver docs/05-OPERACIONES.md §5
  alertPhone    String? // número interno de la inmobiliaria (wa_id) que recibe las alertas
  alertsEnabled Boolean @default(false) // activar una vez que el template `lead_alert` esté aprobado en el WABA

  // Disponibilidad de agenda interna (ej: "09:00-18:00")
  workHoursStart String @default("09:00")
  workHoursEnd   String @default("18:00")

  // Admin
  apiKeyHash String // argon2 de la API key del tenant

  properties   Property[]
  leads        Lead[]
  messages     Message[]
  appointments Appointment[]
  people       Person[]
  leadNotes    LeadNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// PERSONAS (usuarios humanos del panel) Y SESIONES
// ─────────────────────────────────────────────

enum PersonRole {
  OWNER
  AGENT
}

model Person {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  email        String     @unique // único GLOBAL (no compuesto con tenantId), normalizado a minúsculas
  passwordHash String // argon2
  role         PersonRole
  active       Boolean    @default(true)

  sessions             Session[]
  assignedLeads        Lead[]        @relation("LeadAssignee")
  assignedAppointments Appointment[] @relation("AppointmentAssignee")
  authoredNotes        LeadNote[]
  sentMessages         Message[]     @relation("MessageSender")
  pushSubscriptions    PushSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, role, active]) // chequeo "último owner activo" (AC-21) y listado (AC-19)
}

model PushSubscription {
  id        String   @id @default(cuid())
  tenantId  String
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([personId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique // sha256 hex del token opaco; el token en claro nunca se persiste
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([personId]) // revocación masiva por persona (AC-20/22/23)
  @@index([expiresAt]) // purga de sesiones vencidas (follow-up)
}

// ─────────────────────────────────────────────
// PROPIEDADES
// ─────────────────────────────────────────────

enum OperationType {
  SALE // venta
  RENT // alquiler
  TEMP_RENT // alquiler temporario
}

enum PropertyStatus {
  ACTIVE
  RESERVED
  SOLD_OR_RENTED
  PAUSED
}

model Property {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  externalRef  String? // ID en CRM externo (Tokko, etc.)
  title        String
  description  String?
  operation    OperationType
  propertyType String // "departamento" | "casa" | "ph" | "local" | "lote"
  status       PropertyStatus @default(ACTIVE)

  price     Decimal @db.Decimal(14, 2)
  currency  String  @default("USD") // USD | ARS
  expenses  Decimal? @db.Decimal(14, 2) // expensas en ARS

  neighborhood String // normalizado en minúsculas sin tildes
  city         String?
  address      String? // NO se envía al lead hasta agendar

  rooms       Int?
  bedrooms    Int?
  bathrooms   Int?
  areaM2      Int?
  garage      Boolean  @default(false)
  petsAllowed Boolean?
  features    String[] @default([]) // "balcón", "patio", "amenities", ...

  listingUrl String?
  photos     PropertyPhoto[]

  // Post-MVP: re-ranking semántico (mantener nullable, no usar en MVP)
  // embedding  Unsupported("vector(1536)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, externalRef])
  @@index([tenantId, status, operation, neighborhood, price])
  @@index([tenantId, status, operation, rooms])
}

model PropertyPhoto {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String // URL pública (https) accesible por Meta
  position   Int      @default(0)

  @@index([propertyId, position])
}

// ─────────────────────────────────────────────
// LEADS Y CONVERSACIÓN
// ─────────────────────────────────────────────

enum ConversationState {
  GREETING
  QUALIFICATION
  SEARCH_MATCH
  // Entre SEARCH_MATCH y SCHEDULING (spec 09, T1.4): el lead ya confirmó
  // interés en una ficha, pero antes de mandar el link de agenda se le hacen
  // hasta 2 preguntas comerciales (garantía/timeline o contado-crédito/vende
  // algo antes), según la operación. Nunca la decide el LLM.
  COMMERCIAL_QUALIFICATION
  SCHEDULING
  HUMAN_HANDOFF
  OPTED_OUT
}

model Lead {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  phone String // E.164 sin '+' (formato wa_id de Meta)
  name  String?
  state ConversationState @default(GREETING)

  // Filtros capturados por calificación
  fOperation     OperationType?
  fNeighborhoods String[]       @default([])
  fMaxPrice      Decimal?       @db.Decimal(14, 2)
  fCurrency      String?
  fMinRooms      Int?
  fGarage        Boolean? // true = pidió cochera explícitamente
  fPetsAllowed   Boolean? // true = pidió que acepte mascotas
  fNotes         String? // extras en lenguaje natural ("con patio")
  fPreferredDay  String? // "entre semana" | "sábado", detectado al agendar visita
  fOfferedNeighborhoods String[] @default([]) // zonas aledañas sugeridas, pendientes de aceptación (§4)
  // Turno (ver `turnCount`) en el que el lead mencionó precio/moneda por
  // última vez. Permite detectar un fMaxPrice/fCurrency viejo que quedó
  // pegado de muchos turnos atrás y ya no debería aplicarse a una búsqueda
  // nueva sin que el lead lo haya reafirmado (ver filters.util.ts#isPriceStale).
  fPriceMentionedAtTurn Int?

  // Control
  handoffAt     DateTime?
  optedOutAt    DateTime?
  contactedAt   DateTime? // marca de gestión humana (contactado), no es estado de la FSM
  nextActionAt  DateTime? // fecha/hora libre que carga el asesor para retomar el lead
  lastMessageAt DateTime?
  greetedAt     DateTime? // se completa cuando se manda el saludo+aviso legal completo (una sola vez)
  lastSearchIds String[]  @default([]) // IDs del último resultado (validación de salida)
  turnCount     Int       @default(0) // cantidad de turnos procesados por el FSM (ver fPriceMentionedAtTurn)
  // Se pide el nombre una sola vez, recién después de mostrar valor real
  // (teaser o búsqueda completa) — spec 09, T1.1. Si el lead no lo da, no se
  // le vuelve a preguntar (mismo patrón que `greetedAt`).
  nameAskedAt DateTime?

  // ── Calificación comercial (spec 09, T1.2) ──────────────────────────────
  // Valores normalizados a un conjunto cerrado por código (nunca texto crudo
  // del LLM): ver `sanitizeClosedValue` en llm/extraction.schema.ts.
  qTimeline          String? // "inmediato" | "1-3 meses" | "3-6 meses" | "explorando"
  qGuarantee         String? // "propietaria" | "caucion" | "recibo" | "no_tiene" | "no_sabe" (alquiler)
  qPaymentMethod     String? // "contado" | "credito" | "mixto" | "no_sabe" (venta)
  qHasPropertyToSell Boolean? // true = tiene que vender/rescindir algo antes (también es una captación)
  qMotive            String? // texto libre normalizado, no alimenta el score
  qVisitAvailability String? // texto libre ("tardes después de las 18"), no alimenta el score
  // Anti-repregunta: controla el cupo de 2 preguntas comerciales en
  // COMMERCIAL_QUALIFICATION (T1.4). Guarda el NOMBRE del campo ya preguntado
  // ("qGuarantee", "qTimeline", etc.), no el valor.
  qAskedFields String[] @default([])
  // Se recalcula SIEMPRE en código al final de cada turno (lead-score.util.ts,
  // T1.5) — nunca lo decide el LLM.
  qScore      Int? // 0-100
  qScoreLabel String? // "frio" | "tibio" | "caliente"
  // Último turno con una señal de compra fuerte detectada por regex (T3.1;
  // descuento/contado/financiación/etc.), no por el LLM.
  qBuyingSignalAt  DateTime?
  qWantsStockAlert Boolean   @default(false) // pidió aviso cuando entre stock (T3.3)
  // Propiedad elegida al entrar a COMMERCIAL_QUALIFICATION (T1.4): se necesita
  // recordarla durante las 1-2 preguntas comerciales, porque `lastSearchIds`
  // puede no alcanzar para re-derivarla si el lead escribe algo intermedio.
  // Se resuelve al pasar a SCHEDULING y queda huérfana sin problema si el
  // lead abandona el flujo (nunca se lee fuera de este handler).
  pendingPropertyId String?

  assignedUserId String?
  assignedUser   Person? @relation("LeadAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)

  messages     Message[]
  appointments Appointment[]
  notes        LeadNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, phone])
  @@index([tenantId, state])
  @@index([tenantId, lastMessageAt])
}

enum MessageDirection {
  IN
  OUT
}

enum MessageType {
  TEXT
  AUDIO
  IMAGE
  DOCUMENT
  TEMPLATE
  UNSUPPORTED
}

model Message {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId   String
  lead     Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  direction     MessageDirection
  type          MessageType
  waMessageId   String? @unique // ID de Meta (dedupe y status updates)
  body          String? // texto o caption
  mediaId       String? // media_id de Meta
  transcription String? // resultado de STT para audios
  meta          Json? // payload crudo recortado / status

  // Autor humano del mensaje saliente; null = enviado por el bot (100% de los
  // mensajes previos a esta migración). SetNull: borrar una Person NUNCA puede
  // borrar historial de conversación (evidencia / trazabilidad Ley 25.326).
  sentByPersonId String?
  sentByPerson   Person? @relation("MessageSender", fields: [sentByPersonId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([tenantId, leadId, createdAt])
  @@index([sentByPersonId]) // columna líder para que el SetNull no haga seq scan de messages
}

// ─────────────────────────────────────────────
// NOTAS HUMANAS SOBRE EL LEAD (panel de asesores)
// ─────────────────────────────────────────────

model LeadNote {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId   String
  lead     Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  authorPersonId String? // persona autora; null si la persona fue borrada
  author         Person? @relation(fields: [authorPersonId], references: [id], onDelete: SetNull)

  body String

  createdAt DateTime @default(now())

  @@index([tenantId, leadId, createdAt])
}

// ─────────────────────────────────────────────
// AGENDAMIENTO
// ─────────────────────────────────────────────

enum AppointmentStatus {
  PROPOSED // bot ofreció agenda
  CONFIRMED // lead confirmó fecha (manual o vía Calendly webhook post-MVP)
  DONE
  CANCELLED
  NO_SHOW // lead no se presentó a una cita CONFIRMED (B.1)
}

model Appointment {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId      String
  lead        Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  propertyId  String?
  status      AppointmentStatus @default(PROPOSED)
  scheduledAt DateTime?
  notes       String?

  assignedUserId String?
  assignedUser   Person? @relation("AppointmentAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  outcome        String? // resultado libre de la visita (done/no-show), B.1

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, scheduledAt])
}

// ─────────────────────────────────────────────
// IDEMPOTENCIA DE WEBHOOKS
// ─────────────────────────────────────────────

model WebhookEvent {
  id          String   @id @default(cuid())
  waMessageId String   @unique
  tenantId    String?
  receivedAt  DateTime @default(now())

  @@index([receivedAt]) // para purga periódica (> 30 días) — la usa MaintenanceProcessor, no tocar
  @@index([tenantId, receivedAt]) // último evento por tenant (GET /admin/tenants/:id/webhook-status)
}
